{
  "name": "ui-previewer",
  "displayName": "UI Previewer",
  "description": "Click Preview above any React component to render it in a side panel with auto-generated dummy props.",
  "version": "0.0.9",
  "publisher": "Fuja",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "react",
    "preview",
    "component",
    "ui",
    "storybook",
    "tailwind",
    "nextjs",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Fujablack/UI-Previewer.git"
  },
  "bugs": {
    "url": "https://github.com/Fujablack/UI-Previewer/issues"
  },
  "homepage": "https://github.com/Fujablack/UI-Previewer#readme",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "commands": [
      {
        "command": "componentPreviewer.preview",
        "title": "UI Previewer: Preview Component"
      }
    ],
    "configuration": {
      "title": "UI Previewer",
      "properties": {
        "componentPreviewer.globalCss": {
          "type": "string",
          "default": "",
          "description": "Workspace-relative path to a global stylesheet to load in every preview (e.g. src/index.css, or your compiled Tailwind output)."
        },
        "componentPreviewer.fillOptionalProps": {
          "type": "boolean",
          "default": false,
          "description": "Also generate dummy values for optional props (excluding ones inherited from node_modules typings)."
        },
        "componentPreviewer.codeLensPosition": {
          "type": "string",
          "enum": [
            "top",
            "component"
          ],
          "default": "top",
          "enumDescriptions": [
            "Show the Preview link on the first line of the file",
            "Show the Preview link above each component"
          ],
          "description": "Where the Preview link appears."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0"
  },
  "packageManager": "yarn@4.14.1"
}
